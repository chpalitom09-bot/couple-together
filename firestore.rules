rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque utilisateur ne peut modifier que son propre document.
    // La lecture est ouverte aux comptes connectés : nécessaire pour retrouver
    // un partenaire via son code de parrainage (requête where inviteCode == ...).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Un couple ne peut être créé/lu/modifié que par ses deux membres.
    match /couples/{coupleId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if false;

      // Mot secret du jeu de dessin : seul·e la personne qui dessine peut le lire,
      // pour que le mot reste vraiment caché de qui doit deviner.
      match /games/dessin_secret {
        allow read: if request.auth != null && request.auth.uid == resource.data.drawerUid;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members &&
          request.auth.uid == request.resource.data.drawerUid;
        allow update, delete: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      }

      // État de chaque jeu (plateau, tour, dé...) : réservé aux deux membres du couple.
      match /games/{gameId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      }
    }
  }
}
